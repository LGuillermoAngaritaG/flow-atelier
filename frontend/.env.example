VITE_USE_MOCK_API=false
# Optional override for the backend origin. Unset, the SPA talks to whatever
# origin served it (works with `atelier serve`); set this only for a dev server
# on a separate port.
# VITE_BACKEND_URL=http://localhost:8080
# Bearer token for the backend API. Leave empty for unauthenticated/local use,
# and for the bundled UI generally: when the server sets ATELIER_API_TOKEN, the
# UI asks for the token on its first 401 and keeps it for the tab. Set this only
# for a dev server pointed at an already-authenticated backend — a value here is
# compiled into the bundle, so never set it for a build you distribute.
VITE_API_TOKEN=
