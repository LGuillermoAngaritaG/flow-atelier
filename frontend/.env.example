VITE_USE_MOCK_API=false
# Optional override for the backend origin. Unset, the SPA talks to whatever
# origin served it (works with `atelier serve`); set this only for a dev server
# on a separate port.
# VITE_BACKEND_URL=http://localhost:8080
# Bearer token for the backend API. Leave empty for unauthenticated/local use.
VITE_API_TOKEN=
